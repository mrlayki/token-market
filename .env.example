COMPOSE_PROJECT_NAME=token-market
# ===== 基础 =====
TM_ENV=prod
POSTGRES_PASSWORD=tm

# ===== 安全（生产务必修改）=====
# python -c "import secrets;print(secrets.token_urlsafe(48))"
TM_JWT_SECRET=please-change-me-to-a-long-random-string
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
TM_CHANNEL_KEY_SECRET=ZGV2LWNoYW5uZWwta2V5LXNlY3JldC0zMmJ5dGVzISE=
TM_PAYMENT_NOTIFY_SECRET=please-change-me

TM_ROOT_USERNAME=root
TM_ROOT_PASSWORD=ChangeMe123!
TM_PUBLIC_BASE_URL=http://localhost:8080

# ===== 额度 =====
# lua：Redis Lua 原子预扣（默认）；naive：先查后扣（仅用于压测对比，禁止生产使用）
TM_QUOTA_MODE=lua
# Redis 不可用时：pg_fallback 降级到 PG 条件更新；fail_closed 直接拒绝
TM_REDIS_FAIL_MODE=pg_fallback

# ===== 上游厂商 Key（仅 seed 初始化渠道时使用，之后在管理端维护）=====
SEED_OPENAI_API_KEY=
SEED_ANTHROPIC_API_KEY=
SEED_DEEPSEEK_API_KEY=

# ===== 本地开发（不在 docker 中运行 server 时）=====
# TM_DATABASE_URL=postgresql+asyncpg://tm:tm@localhost:15432/token_market
# TM_REDIS_URL=redis://localhost:16379/0
# ===== 容量 =====
# 进程数建议 = CPU 核数（relay 每进程约 250MB 内存）。
# 连接池总数 = Σ(进程数 × (TM_DB_POOL_SIZE + TM_DB_MAX_OVERFLOW)) 须小于 Postgres max_connections(300)
API_WORKERS=2
RELAY_WORKERS=2
